---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { SITE } from '../lib/site';
import { getSessionUser } from '../lib/auth';
import { getDB } from '../lib/db';
import { getUserProfile, type UserProfile } from '../lib/users';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.name, description = SITE.description } = Astro.props;
const fullTitle = title === SITE.name ? SITE.name : `${title} · ${SITE.name}`;

// The session cookie is HttpOnly, so the signed-in state is resolved here on the
// server and handed to the navbar as a prop. The custom avatar lives in D1 (it can
// be a data URL far larger than the cookie limit), so it is overlaid on the session.
const session = await getSessionUser(Astro);
let user: Pick<UserProfile, 'githubId' | 'githubUsername' | 'name' | 'avatarUrl'> | null = null;
if (session) {
  try {
    user = await getUserProfile(getDB(Astro.locals), session);
  } catch {
    // A database hiccup must not take down the whole page; fall back to the session.
    user = {
      githubId: session.githubId,
      githubUsername: session.githubUsername,
      name: session.name,
      avatarUrl: session.avatarUrl ?? '',
    };
  }
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/romeo-banner.png" />
    <meta property="og:image:alt" content="ROMeo, the OpenROM mascot, in a retro arcade shop" />
    <link rel="icon" type="image/png" href="/images/romeo-logo.png" />
    <link rel="apple-touch-icon" href="/images/romeo-logo.png" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-200 antialiased">
    <Navbar user={user} />
    <slot />
    <footer class="mt-24 border-t border-zinc-900">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-zinc-500 sm:flex-row sm:px-6 lg:px-8"
      >
        <p>
          OpenROM Marketplace — metadata-only catalog. Bundles are hosted on
          SourceForge and verified by SHA-256.
        </p>
        <div class="flex items-center gap-5">
          <a class="transition hover:text-cyan-400" href={SITE.github}>GitHub</a>
          <a class="transition hover:text-cyan-400" href={SITE.discord}>Discord</a>
          <a class="transition hover:text-cyan-400" href={SITE.contributing}>Publish</a>
        </div>
      </div>
    </footer>
  </body>
</html>
