---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

export const prerender = false;

Astro.response.status = 404;
---

<Layout
  title="Page not found"
  description="Whoops! ROMeo got lost in the bitstream. That page does not exist on the OpenROM Marketplace."
>
  <main class="relative mx-auto flex max-w-2xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8">
    <div
      class="pointer-events-none absolute left-1/2 top-24 h-64 w-64 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <img
      src="/images/romeo-error.png"
      alt="ROMeo, the OpenROM mascot, looking dizzy with a bandage on his head"
      width="140"
      height="140"
      class="relative h-[140px] w-[140px] object-contain drop-shadow-[0_0_28px_rgba(34,211,238,0.25)]"
    />
    <h1 class="relative mt-6 text-3xl font-bold tracking-tight text-white">
      Whoops! ROMeo got lost in the bitstream (404).
    </h1>
    <p class="relative mt-3 max-w-md text-sm leading-relaxed text-zinc-400">
      That page does not exist — it may have been renamed, moved, or the link that brought you here
      is out of date.
    </p>
    <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-11 items-center gap-2 rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-5 text-sm font-semibold text-zinc-950 transition hover:from-cyan-400 hover:to-purple-400"
      >
        <Icon name="arrow-left" class="h-4 w-4" />
        Back to Safety
      </a>
      <a
        href="/#catalog"
        class="inline-flex h-11 items-center gap-2 rounded-lg border border-zinc-800 px-5 text-sm font-medium text-zinc-200 transition hover:border-zinc-700 hover:text-white"
      >
        Browse extensions
      </a>
    </div>
  </main>
</Layout>
