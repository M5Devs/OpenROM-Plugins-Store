---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getDB, getPlugin } from '../../lib/db';
import { PLATFORM_ICONS, SITE, categoryLabel } from '../../lib/site';
import {
  isTheme,
  themePalette,
  themeSwatches,
  themeScreenshots,
  contrastText,
  themeApplyUri,
  orskinFileName,
} from '../../lib/theme';
import { renderMarkdown } from '../../lib/markdown';
import { compatibilityFor, detectOS, supportedLabel } from '../../lib/detectOS';

export const prerender = false;

const id = Astro.params.id ?? '';

// A D1 read can fail outright (missing table, unavailable binding). That is a
// server problem, not a missing plugin, so it must not surface as an unhandled
// 500 — mirror the publisher page and report it as a 503 instead.
let plugin = null;
let dbError = false;
try {
  plugin = await getPlugin(getDB(Astro.locals), id);
} catch (error) {
  console.error(`Failed to load plugin "${id}"`, error);
  dbError = true;
}

if (dbError) {
  Astro.response.status = 503;
} else if (!plugin) {
  Astro.response.status = 404;
}

const cli = plugin ? `openrom-core --install-plugin ${plugin.id}` : '';
const published = Boolean(plugin?.sha256);

const theme = Boolean(plugin && isTheme(plugin.category));
const palette = theme ? themePalette(plugin!.routes) : [];
const swatches = theme ? themeSwatches(plugin!.routes) : [];
const screenshots = plugin ? themeScreenshots(plugin.screenshots) : [];
const showGallery = theme && screenshots.length > 0;
const applyUri = plugin ? themeApplyUri(plugin.id) : '';
const downloadName = plugin ? (theme ? orskinFileName(plugin.id) : `${plugin.id}.orplug`) : '';

// Colours drive the mockup preview, so they must be validated (see lib/theme).
const background = palette.find((entry) => entry.role === 'Background')?.hex ?? '#0d0e15';
const surface = palette.find((entry) => entry.role === 'Surface')?.hex ?? '#161926';
const accent = palette.find((entry) => entry.role === 'Accent')?.hex ?? '#00f0ff';
const text = palette.find((entry) => entry.role === 'Text')?.hex ?? '#ffffff';
const onBackground = contrastText(background);
const onAccent = contrastText(accent);
const readmeHtml = plugin
  ? renderMarkdown(plugin.readme) ||
    '<p class="text-zinc-500">No README has been published for this extension yet.</p>'
  : '';

const manifest = plugin
  ? {
      id: plugin.id,
      name: plugin.name,
      version: plugin.version,
      minCoreVersion: plugin.minCoreVersion,
      publisher: {
        id: plugin.publisherId,
        name: plugin.publisherName,
        verified: plugin.publisherVerified,
      },
      category: plugin.category,
      description: plugin.description,
      // A theme's "routes" column holds its colour palette; label it honestly.
      ...(isTheme(plugin.category)
        ? { palette: plugin.routes }
        : { routes: plugin.routes }),
      platforms: plugin.platforms,
      downloadUrl: plugin.downloadUrl,
      sha256: plugin.sha256 || null,
      icon: plugin.icon,
    }
  : null;

// Compatibility is decided from the request's User-Agent so the pill is correct
// on first paint. The client re-checks against navigator.userAgent and corrects
// it (iPadOS in desktop mode reports a Macintosh UA), which is why the server
// result is only a starting point.
const detectedOS = detectOS(Astro.request.headers.get('user-agent'));
const compatibility = plugin ? compatibilityFor(detectedOS, plugin.platforms) : 'unknown';
const supportedText = plugin ? supportedLabel(plugin.platforms) : '';

const heading = dbError ? 'Plugin unavailable' : 'Plugin not found';
const displayHeading = dbError
  ? 'Plugin unavailable'
  : 'Whoops! ROMeo got lost in the bitstream (404).';
const body = dbError
  ? 'We could not load this plugin right now. This is usually temporary — please try again shortly.'
  : `No plugin exists with the id “${id}”. It may have been renamed, or the link that brought you here may be out of date.`;
---

<Layout title={plugin?.name ?? heading} description={plugin?.description ?? body}>
  {
    !plugin ? (
      <main class="relative mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:px-8">
        <div
          class="pointer-events-none absolute left-1/2 top-28 h-56 w-56 -translate-x-1/2 rounded-full bg-cyan-500/10 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <img
          src="/images/romeo-error.png"
          alt="ROMeo, the OpenROM mascot, looking dizzy with a bandage on his head"
          width="140"
          height="140"
          class="relative h-[140px] w-[140px] object-contain drop-shadow-[0_0_28px_rgba(34,211,238,0.25)]"
        />
        <h1 class="relative mt-6 text-2xl font-bold tracking-tight text-white">{displayHeading}</h1>
        <p class="relative mt-3 max-w-md text-sm leading-relaxed text-zinc-400">{body}</p>
        <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="inline-flex h-10 items-center gap-2 rounded-lg border border-zinc-800 px-4 text-sm font-medium text-zinc-200 transition hover:border-zinc-700 hover:text-white"
          >
            <Icon name="arrow-left" class="h-4 w-4" />
            Back to Marketplace
          </a>
          {dbError && (
            <button
              type="button"
              data-retry
              class="inline-flex h-10 items-center gap-2 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 text-sm font-medium text-cyan-200 transition hover:border-cyan-400 hover:text-cyan-100"
            >
              <Icon name="sparkles" class="h-4 w-4" />
              Try again
            </button>
          )}
        </div>
      </main>
    ) : (
      <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-sm text-zinc-400 transition hover:text-cyan-300"
        >
          <Icon name="arrow-left" class="h-4 w-4" />
          Back to Marketplace
        </a>

        {/* Hero */}
        <header class="mt-6 rounded-2xl border border-zinc-800 bg-zinc-900/40 p-6 sm:p-8">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-cyan-400/15 to-purple-500/15 text-cyan-300 ring-1 ring-inset ring-zinc-700/60">
              <Icon name={plugin.icon} class="h-8 w-8" />
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h1 class="text-2xl font-bold tracking-tight text-white">{plugin.name}</h1>
                <span class="rounded-md border border-zinc-800 bg-zinc-950/60 px-2 py-0.5 font-mono text-xs text-zinc-400">
                  v{plugin.version}
                </span>
                <span class="rounded-md border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-xs font-medium text-cyan-300">
                  {categoryLabel(plugin.category)}
                </span>
              </div>

              <p class="mt-2 flex flex-wrap items-center gap-x-2 text-sm text-zinc-400">
                <span class="text-zinc-500">by</span>
                {plugin.publisherId ? (
                  <a
                    href={`/publisher/${plugin.publisherId}`}
                    class="inline-flex items-center gap-1.5 font-medium text-zinc-200 transition hover:text-cyan-300"
                  >
                    {plugin.publisherName}
                    {plugin.publisherVerified && (
                      <Icon name="badge-check" class="h-4 w-4 text-cyan-400" />
                    )}
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1.5 font-medium text-zinc-200">
                    {plugin.publisherName}
                    {plugin.publisherVerified && (
                      <Icon name="badge-check" class="h-4 w-4 text-cyan-400" />
                    )}
                  </span>
                )}
                <span aria-hidden="true">·</span>
                <span>min core {plugin.minCoreVersion}</span>
              </p>

              <p class="mt-3 max-w-2xl text-pretty text-sm leading-relaxed text-zinc-400">
                {plugin.description}
              </p>
            </div>
          </div>

          {/* Live OS compatibility. The server renders it from the request
              User-Agent so it is correct on first paint; the client re-checks
              and only toggles `hidden` on whole nodes, so a correction can never
              shift the layout. */}
          <div
            class="mt-6"
            data-compat
            data-compat-state={compatibility}
            data-platforms={plugin.platforms.join(',')}
          >
            <div
              data-compat-shell
              class:list={[
                'rounded-xl border p-4',
                compatibility === 'compatible' &&
                  'border-emerald-500/40 bg-emerald-500/10 shadow-[0_0_25px_rgba(16,185,129,0.15)]',
                compatibility === 'incompatible' &&
                  'border-amber-500/40 bg-amber-500/10 shadow-[0_0_25px_rgba(245,158,11,0.12)]',
                compatibility === 'unknown' && 'hidden',
              ]}
            >
              <div class="flex items-start gap-2.5">
                <span
                  data-compat-icon="compatible"
                  class:list={['shrink-0', compatibility !== 'compatible' && 'hidden']}
                >
                  <Icon name="check-circle" class="h-5 w-5 text-emerald-400" />
                </span>
                <span
                  data-compat-icon="incompatible"
                  class:list={['shrink-0', compatibility !== 'incompatible' && 'hidden']}
                >
                  <Icon name="alert-triangle" class="h-5 w-5 text-amber-400" />
                </span>
                <div class="min-w-0">
                  <p
                    data-compat-text
                    class:list={[
                      'text-sm font-medium',
                      compatibility === 'compatible' && 'text-emerald-300',
                      compatibility === 'incompatible' && 'text-amber-300',
                    ]}
                  >
                    {compatibility === 'compatible'
                      ? `✅ Compatible with your system (${detectedOS})`
                      : compatibility === 'incompatible'
                        ? `⚠️ Not compatible with your current OS (${detectedOS})`
                        : ''}
                  </p>

                  <p
                    data-compat-supported
                    class:list={['mt-2 text-sm text-zinc-400', compatibility !== 'incompatible' && 'hidden']}
                  >
                    Only available on:{' '}
                    <span class="font-medium text-zinc-300" data-compat-platforms>{supportedText}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>

          {/* Actions */}
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {published ? (
              <a
                href={theme ? applyUri : `openrom://plugin/${plugin.id}`}
                class="inline-flex h-11 items-center gap-2 rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-5 text-sm font-semibold text-zinc-950 shadow-lg shadow-cyan-500/20 transition hover:from-cyan-400 hover:to-purple-400"
              >
                <Icon name={theme ? 'palette' : 'zap'} class="h-4 w-4" />
                {theme ? 'Apply in OpenROM' : 'Install in OpenROM'}
              </a>
            ) : (
              <span
                title={theme
                  ? 'No .orskin file has been published for this theme yet'
                  : 'No .orplug bundle has been published for this extension yet'}
                class="inline-flex h-11 cursor-not-allowed items-center gap-2 rounded-lg border border-zinc-800 px-5 text-sm font-medium text-zinc-500"
              >
                <Icon name={theme ? 'palette' : 'zap'} class="h-4 w-4" />
                {theme ? 'Theme not published yet' : 'Bundle not published yet'}
              </span>
            )}

            {published && (
              <a
                href={`/api/download/${plugin.id}`}
                class="inline-flex h-11 items-center gap-2 rounded-lg border border-zinc-800 px-5 text-sm font-medium text-zinc-200 transition hover:border-zinc-700 hover:text-white"
              >
                <Icon name="download" class="h-4 w-4" />
                Download {theme ? '.orskin' : '.orplug'}
              </a>
            )}

            <button
              type="button"
              data-copy={theme ? applyUri : cli}
              class="inline-flex h-11 items-center gap-2 rounded-lg border border-zinc-800 px-5 text-sm font-medium text-zinc-200 transition hover:border-zinc-700 hover:text-white"
            >
              <Icon name={theme ? 'copy' : 'terminal'} class="h-4 w-4" />
              {theme ? 'Copy URI' : 'Copy CLI Install'}
            </button>
          </div>

          {
            published && (
              <p class="mt-3 text-xs text-zinc-500">
                {theme ? (
                  <>
                    Applying a theme needs OpenROM installed. If nothing happens, use{' '}
                    <a href={`/api/download/${plugin.id}`} class="text-cyan-400 hover:underline">
                      the .orskin download
                    </a>{' '}
                    and open it from the app.
                  </>
                ) : (
                  <>
                    One-click install needs OpenROM Core installed. If nothing happens, use{' '}
                    <a href={`/api/download/${plugin.id}`} class="text-cyan-400 hover:underline">
                      the .orplug download
                    </a>{' '}
                    or the CLI command above.
                  </>
                )}
              </p>
            )
          }

          {/* The download stays available when the visitor's OS is not supported,
              but the label says what they are getting so it is a deliberate choice. */}
          <p
            data-compat-download-anyway
            class:list={[
              'mt-3 text-xs text-zinc-500',
              compatibility !== 'incompatible' && 'hidden',
            ]}
          >
            Downloading anyway?{' '}
            <a href={`/api/download/${plugin.id}`} class="text-amber-400 hover:underline">
              Download anyway for another PC
            </a>
            .
          </p>

          {/* Quick facts */}
          <dl class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-zinc-800/70 pt-5 text-xs text-zinc-500">
            <div class="flex items-center gap-1.5">
              <Icon name="download" class="h-3.5 w-3.5" />
              <span class="font-medium text-zinc-300">{plugin.downloads.toLocaleString()}</span>
              <span>downloads</span>
            </div>
            <div class="flex items-center gap-3">
              {plugin.platforms.map((platform) => (
                <span class="inline-flex items-center gap-1.5" title={platform}>
                  <Icon name={PLATFORM_ICONS[platform] ?? 'package'} class="h-3.5 w-3.5" />
                  <span>{platform}</span>
                </span>
              ))}
            </div>
          </dl>
        </header>

        <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
          {/* Main column */}
          <div class="flex flex-col gap-8">
            <section class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">Overview</h2>
              <div class="prose mt-4" set:html={readmeHtml} />
            </section>

            {
              theme && (
                <>
                  {/* Screenshot showcase — the OpenROM desktop app wearing this skin. */}
                  {showGallery && (
                    <section
                      class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6"
                      data-gallery
                    >
                      <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                        Screenshots
                      </h2>
                      <p class="mt-1.5 text-sm text-zinc-400">
                        OpenROM running with <span class="text-zinc-200">{plugin.name}</span> applied.
                      </p>

                      {/* Featured frame — every image is rendered up front and toggled with
                          `hidden`, so switching thumbnails never waits on a network fetch. */}
                      <div class="mt-4 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950">
                        {screenshots.map((shot, index) => (
                          <img
                            data-gallery-frame
                            src={shot}
                            alt={`${plugin.name} applied to the OpenROM desktop app — screenshot ${index + 1} of ${screenshots.length}`}
                            loading={index === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                            class:list={['h-auto w-full', index !== 0 && 'hidden']}
                          />
                        ))}
                      </div>

                      {screenshots.length > 1 && (
                        <div
                          class="mt-4 flex flex-wrap gap-3"
                          role="tablist"
                          aria-label="Theme screenshots"
                        >
                          {screenshots.map((shot, index) => (
                            <button
                              type="button"
                              data-gallery-thumb
                              role="tab"
                              aria-selected={index === 0 ? 'true' : 'false'}
                              aria-label={`Show screenshot ${index + 1}`}
                              class:list={[
                                'h-16 w-24 shrink-0 overflow-hidden rounded-lg border-2 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400',
                                index === 0 ? 'border-cyan-400' : 'border-zinc-800 hover:border-zinc-700',
                              ]}
                            >
                              <img
                                src={shot}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                class="h-full w-full object-cover"
                              />
                            </button>
                          ))}
                        </div>
                      )}
                    </section>
                  )}

                  {/* Mini App Mockup Preview */}
                  <section class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                      Live Preview
                    </h2>
                    <p class="mt-1.5 text-sm text-zinc-400">
                      A mock OpenROM window painted with this theme's exact colours.
                    </p>

                    <div
                      class="mt-4 overflow-hidden rounded-xl border"
                      style={`background:${background};border-color:${surface}`}
                      data-theme-preview
                    >
                      {/* Title bar */}
                      <div
                        class="flex items-center gap-2 px-4 py-2.5"
                        style={`background:${surface}`}
                      >
                        <span class="flex gap-1.5" aria-hidden="true">
                          <span
                            class="h-2.5 w-2.5 rounded-full"
                            style={`background:${accent}`}
                          />
                          <span
                            class="h-2.5 w-2.5 rounded-full opacity-60"
                            style={`background:${accent}`}
                          />
                          <span
                            class="h-2.5 w-2.5 rounded-full opacity-30"
                            style={`background:${accent}`}
                          />
                        </span>
                        <span
                          class="ml-2 text-xs font-medium"
                          style={`color:${contrastText(surface)}`}
                        >
                          OpenROM — {plugin.name}
                        </span>
                      </div>

                      {/* Body */}
                      <div class="flex items-center gap-5 p-5">
                        <img
                          src="/images/romeo-logo.png"
                          alt="ROMeo, the OpenROM mascot, rendered over the theme colours"
                          width="64"
                          height="64"
                          class="h-16 w-16 shrink-0 rounded-xl object-contain"
                          style={`background:${surface}`}
                        />
                        <div class="min-w-0 flex-1">
                          <p
                            class="truncate text-sm font-semibold"
                            style={`color:${onBackground}`}
                          >
                            Super Preserved Adventure
                          </p>
                          <p
                            class="mt-0.5 text-xs opacity-70"
                            style={`color:${onBackground}`}
                          >
                            Disc 1 of 2 · Verified dump
                          </p>
                          <div class="mt-3 flex items-center gap-2">
                            <span
                              class="inline-flex items-center rounded-md px-3 py-1.5 text-xs font-semibold"
                              style={`background:${accent};color:${onAccent}`}
                            >
                              ▶ Play
                            </span>
                            <span
                              class="inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium"
                              style={`background:${surface};color:${contrastText(surface)}`}
                            >
                              Library
                            </span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>

                  {/* Colour Palette Inspector */}
                  <section class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                      Colour Palette Inspector
                    </h2>
                    {palette.length > 0 ? (
                      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                        {palette.map((entry) => (
                          <li class="flex items-center gap-3 rounded-lg border border-zinc-800 bg-zinc-950/50 p-3">
                            <span
                              class="h-9 w-9 shrink-0 rounded-lg ring-1 ring-inset ring-white/15"
                              style={`background:${entry.hex}`}
                              aria-hidden="true"
                            />
                            <span class="min-w-0 flex-1">
                              <span class="block text-xs font-medium text-zinc-400">
                                {entry.role}
                              </span>
                              <span class="block font-mono text-sm text-zinc-200">
                                {entry.hex}
                              </span>
                            </span>
                            <button
                              type="button"
                              data-copy={entry.hex}
                              aria-label={`Copy ${entry.role} colour ${entry.hex}`}
                              class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-zinc-800 text-zinc-400 transition hover:text-cyan-300"
                            >
                              <Icon name="copy" class="h-4 w-4" />
                            </button>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="mt-4 text-sm text-zinc-500">
                        This theme has not published a colour palette yet.
                      </p>
                    )}

                    {swatches.length > 0 && (
                      <div class="mt-5 border-t border-zinc-800/70 pt-4">
                        <p class="text-xs font-medium text-zinc-500">Raw palette</p>
                        <div class="mt-2 flex flex-wrap items-center gap-2">
                          {swatches.map((hex) => (
                            <span
                              class="h-6 w-6 rounded-full ring-1 ring-inset ring-white/15"
                              style={`background:${hex}`}
                              title={hex}
                            />
                          ))}
                        </div>
                      </div>
                    )}
                  </section>
                </>
              )
            }

            <section class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                {theme ? 'How it applies' : 'Supported Routes'}
              </h2>
              {theme ? (
                <ol class="mt-4 flex flex-col gap-2 text-sm text-zinc-400">
                  <li class="flex gap-2">
                    <span class="text-zinc-600">1.</span>
                    <span>
                      Download the <span class="font-mono text-zinc-300">.orskin</span> file, or
                      open the deep link below directly from OpenROM.
                    </span>
                  </li>
                  <li class="flex gap-2">
                    <span class="text-zinc-600">2.</span>
                    <span>
                      OpenROM reads the palette and repaints its interface immediately — no restart.
                    </span>
                  </li>
                  <li class="flex gap-2">
                    <span class="text-zinc-600">3.</span>
                    <span>Switch back to any other theme from <em>Settings → Appearance</em>.</span>
                  </li>
                </ol>
              ) : plugin.routes.length > 0 ? (
                <div class="mt-4 flex flex-wrap gap-2">
                  {plugin.routes.map((route) => (
                    <span class="inline-flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-950/60 px-3 py-1.5 font-mono text-xs text-zinc-200">
                      <Icon name="route" class="h-3.5 w-3.5 text-cyan-400" />
                      {route.replace(/\s*->\s*/, ' ➔ ')}
                    </span>
                  ))}
                </div>
              ) : (
                <p class="mt-4 text-sm text-zinc-500">No conversion routes declared.</p>
              )}
            </section>

            <section class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                {theme ? 'Apply this theme' : 'Installation'}
              </h2>

              {theme ? (
                <>
                  <div class="mt-4">
                    <h3 class="text-sm font-semibold text-zinc-200">Deep link</h3>
                    <p class="mt-1.5 text-sm text-zinc-400">
                      Apply the theme straight from the app. OpenROM fetches the palette and
                      activates it without a restart.
                    </p>
                    <div class="mt-3 flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-950/60 p-3">
                      <code class="flex-1 overflow-x-auto font-mono text-xs text-cyan-300">
                        {applyUri}
                      </code>
                      <button
                        type="button"
                        data-copy={applyUri}
                        aria-label="Copy theme URI"
                        class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-zinc-800 text-zinc-400 transition hover:text-cyan-300"
                      >
                        <Icon name="copy" class="h-4 w-4" />
                      </button>
                    </div>
                  </div>

                  <div class="mt-6">
                    <h3 class="text-sm font-semibold text-zinc-200">Or install from file</h3>
                    <ol class="mt-2 flex flex-col gap-1.5 text-sm text-zinc-400">
                      <li class="flex gap-2">
                        <span class="text-zinc-600">1.</span>
                        <span>
                          Download the <span class="font-mono text-zinc-300">.orskin</span> file
                          above.
                        </span>
                      </li>
                      <li class="flex gap-2">
                        <span class="text-zinc-600">2.</span>
                        <span>
                          Drag it onto the OpenROM window, or use{' '}
                          <em>Settings → Appearance → Import…</em>.
                        </span>
                      </li>
                      <li class="flex gap-2">
                        <span class="text-zinc-600">3.</span>
                        <span>OpenROM validates the palette and applies it right away.</span>
                      </li>
                    </ol>
                  </div>
                </>
              ) : (
                <>
                  <div class="mt-4">
                    <h3 class="text-sm font-semibold text-zinc-200">Command line</h3>
                    <p class="mt-1.5 text-sm text-zinc-400">
                      Install with OpenROM Core. This fetches the bundle and verifies its SHA-256
                      before installing.
                    </p>
                    <div class="mt-3 flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-950/60 p-3">
                      <code class="flex-1 overflow-x-auto font-mono text-xs text-cyan-300">{cli}</code>
                      <button
                        type="button"
                        data-copy={cli}
                        aria-label="Copy install command"
                        class="grid h-8 w-8 shrink-0 place-items-center rounded-md border border-zinc-800 text-zinc-400 transition hover:text-cyan-300"
                      >
                        <Icon name="copy" class="h-4 w-4" />
                      </button>
                    </div>
                  </div>

                  <div class="mt-6">
                    <h3 class="text-sm font-semibold text-zinc-200">Desktop app</h3>
                    <ol class="mt-2 flex flex-col gap-1.5 text-sm text-zinc-400">
                      <li class="flex gap-2">
                        <span class="text-zinc-600">1.</span>
                        <span>
                          Download the <span class="font-mono text-zinc-300">.orplug</span> bundle
                          above.
                        </span>
                      </li>
                      <li class="flex gap-2">
                        <span class="text-zinc-600">2.</span>
                        <span>
                          Drag the file onto the OpenROM window, or use <em>Install from file…</em>.
                        </span>
                      </li>
                      <li class="flex gap-2">
                        <span class="text-zinc-600">3.</span>
                        <span>OpenROM checks the checksum and installs it automatically.</span>
                      </li>
                    </ol>
                  </div>
                </>
              )}
            </section>
          </div>

          {/* Sidebar */}
          <aside class="flex flex-col gap-6">
            <section class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-6">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-400">
                Manifest Specs
              </h2>

              {published ? (
                <div class="mt-4">
                  <p class="text-xs font-medium text-zinc-500">SHA-256 checksum</p>
                  <div class="mt-2 flex items-start gap-2 rounded-lg border border-zinc-800 bg-zinc-950/60 p-3">
                    <code class="min-w-0 flex-1 break-all font-mono text-[0.7rem] leading-relaxed text-zinc-300">
                      {plugin.sha256}
                    </code>
                    <button
                      type="button"
                      data-copy={plugin.sha256}
                      aria-label="Copy SHA-256 checksum"
                      class="grid h-7 w-7 shrink-0 place-items-center rounded-md border border-zinc-800 text-zinc-400 transition hover:text-cyan-300"
                    >
                      <Icon name="copy" class="h-3.5 w-3.5" />
                    </button>
                  </div>
                </div>
              ) : (
                <p class="mt-4 text-xs text-zinc-500">
                  No <span class="font-mono">.orplug</span> bundle has been published for this
                  extension yet, so it cannot be installed. Track progress on{' '}
                  <a class="text-cyan-400 hover:underline" href={SITE.github}>
                    GitHub
                  </a>.
                </p>
              )}

              <p class="mt-5 text-xs font-medium text-zinc-500">plugin.json</p>
              <pre class="mt-2 overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-950 p-4 font-mono text-[0.7rem] leading-relaxed text-zinc-300">
                {JSON.stringify(manifest, null, 2)}
              </pre>
            </section>
          </aside>
        </div>
      </main>
    )
  }
</Layout>

<script>
  import { initCompatibility } from '../../lib/compat-client';
  import { initGallery } from '../../lib/gallery-client';

  document.querySelectorAll<HTMLElement>('[data-compat]').forEach(initCompatibility);
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
  document.querySelector('[data-retry]')?.addEventListener('click', () => location.reload());

  document.addEventListener('click', async (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-copy]');
    if (!trigger) return;
    const text = trigger.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
      const original = trigger.innerHTML;
      trigger.innerHTML = '<span class="text-cyan-400">copied</span>';
      setTimeout(() => (trigger.innerHTML = original), 1200);
    } catch {
      /* clipboard unavailable */
    }
  });
</script>
