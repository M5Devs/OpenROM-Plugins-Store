---
import Icon from './Icon.astro';

interface Props {
  /** Name of the hidden input that carries the value the form submits. */
  name: string;
  label: string;
  value?: string;
  variant?: 'avatar' | 'banner';
  maxDimension?: number;
  quality?: number;
  urlPlaceholder?: string;
  initials?: string;
  hint?: string;
}

const {
  name,
  label,
  value = '',
  variant = 'avatar',
  maxDimension = 512,
  quality = 0.85,
  urlPlaceholder = 'https://…/image.png',
  initials = '',
  hint,
} = Astro.props;

// A stored data URL is far too long to show in the URL box; only real URLs are echoed back.
const urlValue = value && !value.startsWith('data:') ? value : '';
const previewClass =
  variant === 'banner'
    ? 'h-24 w-full rounded-xl object-cover ring-1 ring-inset ring-zinc-700'
    : 'h-20 w-20 rounded-xl object-cover ring-1 ring-inset ring-zinc-700';
---

<div
  data-image-field
  data-image-max={maxDimension}
  data-image-quality={quality}
  class="flex flex-col gap-3"
>
  <span class="text-xs font-medium text-zinc-400">{label}</span>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <div
      class:list={[
        'relative shrink-0 overflow-hidden bg-zinc-950/60 ring-1 ring-inset ring-zinc-800',
        variant === 'banner' ? 'h-24 w-full rounded-xl sm:w-64' : 'h-20 w-20 rounded-xl',
      ]}
    >
      <img
        data-image-preview
        src={value || undefined}
        alt=""
        referrerpolicy="no-referrer"
        class:list={[previewClass, value ? '' : 'hidden', 'absolute inset-0 h-full w-full']}
      />
      <span
        data-image-placeholder
        class:list={[
          'absolute inset-0 grid place-items-center text-lg font-semibold text-zinc-500',
          value ? 'hidden' : '',
        ]}
      >
        {initials || '—'}
      </span>
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <label class="inline-flex h-9 cursor-pointer items-center gap-2 rounded-lg border border-zinc-800 px-3 text-xs font-medium text-zinc-200 transition hover:border-cyan-500/40 hover:text-cyan-300 focus-within:border-cyan-500/50 focus-within:ring-2 focus-within:ring-cyan-500/20">
          <Icon name="image" class="h-4 w-4" />
          Upload image
          <input
            data-image-file
            type="file"
            accept="image/png,image/jpeg,image/webp"
            class="sr-only"
          />
        </label>
        <button
          type="button"
          data-image-clear
          class:list={[
            'inline-flex h-9 items-center gap-1.5 rounded-lg border border-zinc-800 px-3 text-xs text-zinc-400 transition hover:border-red-500/40 hover:text-red-300',
            value ? '' : 'hidden',
          ]}
        >
          Remove
        </button>
      </div>

      <input
        data-image-url
        type="url"
        value={urlValue}
        placeholder={urlPlaceholder}
        class="h-9 rounded-lg border border-zinc-800 bg-zinc-950/60 px-3 text-xs text-zinc-100 placeholder:text-zinc-600 focus:border-cyan-500/50 focus:outline-none focus:ring-2 focus:ring-cyan-500/20"
      />

      <input type="hidden" name={name} data-image-value value={value} />

      <p data-image-meta class="text-[0.7rem] text-zinc-500"></p>
      {hint && <p class="text-[0.7rem] leading-relaxed text-zinc-600">{hint}</p>}
    </div>
  </div>
</div>

<script>
  import { initImageField } from '../lib/image-client';

  document.querySelectorAll<HTMLElement>('[data-image-field]').forEach((root) => {
    const status = root.closest('form')?.querySelector<HTMLElement>('[data-form-status]') ?? null;
    initImageField(root, {
      onStatus: (message) => {
        if (status) {
          status.textContent = message;
          status.className = 'text-sm text-zinc-400';
        }
      },
      onError: (message) => {
        if (status) {
          status.textContent = message;
          status.className = 'text-sm text-red-400';
        }
      },
    });
  });
</script>
